# Copy to .env at repo root (used by Vite for `pnpm dev` in packages/home).
# Never commit real keys.

# When the UI is at http://localhost:8888 but Docker/services run on your NAS (e.g. Unraid "tower"):
# VITE_LAUNCH_HOST=tower
# VITE_LAUNCH_PROTOCOL=http

# --- Unraid Compose (docker-compose.unraid.yml) ---
# Only secrets need to live in .env on the NAS:
# UNRAID_API_KEY=your-unraid-api-key
# POSTGRES_PASSWORD=choose_a_strong_password   # game stack only

# --- Local dev (Vite + API middleware) ---
UNRAID_GRAPHQL_URL=http://tower:8080/graphql
# UNRAID_API_KEY=

# Database Configuration (local dev / game stack)
DATABASE_URL=postgresql://postgres:postgres@db:5432/game_hub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=game_hub

# API and Gateway (local dev)
VITE_BACKEND_URL=http://localhost:3001

# Optional: override host port for nasmono-home on Unraid (default 8888 in compose)
# HOME_BACKEND_PORT=8888

# Immich & Other Services
VITE_IMMICH_KEY=
VITE_RADARR_API_KEY=
VITE_SONARR_API_KEY=
VITE_QBIT_USERNAME=
VITE_QBIT_PASSWORD=

# Optional: custom Docker socket path (default /var/run/docker.sock)
# DOCKER_SOCKET_PATH=/var/run/docker.sock
