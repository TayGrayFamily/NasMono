# Copy to .env at repo root (used by Vite for `pnpm dev` in packages/home).
# Never commit real keys.

# When the UI is at http://localhost:8888 but Docker/services run on your NAS (e.g. Unraid "tower"):
# VITE_LAUNCH_HOST=tower
# VITE_LAUNCH_PROTOCOL=http

# Database Configuration
# When running in Docker, use the service name 'db' as the host.
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@db:5432/game_hub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=game_hub
POSTGRES_PORT=5432

# API and Gateway
VITE_BACKEND_URL=http://localhost:3001
GAME_SERVER_PORT=3001
GAME_HUB_PORT=8000

# Immich & Other Services
VITE_IMMICH_KEY=
VITE_RADARR_API_KEY=
VITE_SONARR_API_KEY=
VITE_QBIT_USERNAME=
VITE_QBIT_PASSWORD=

# Optional: Unraid GraphQL (dev API middleware). Same vars work in compose for the container.
# UNRAID_GRAPHQL_URL=http://your-unraid-ip/graphql
# UNRAID_API_KEY=

# Optional: custom Docker socket path (default /var/run/docker.sock)
# DOCKER_SOCKET_PATH=/var/run/docker.sock
