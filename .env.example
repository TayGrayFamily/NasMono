# Copy to .env at repo root for local dev (`pnpm dev:home`).
# Never commit real keys.

# --- Unraid Compose (docker-compose.unraid.yml) ---
# Minimal .env on the NAS:
#   UNRAID_API_KEY=your-unraid-api-key
#   POSTGRES_PASSWORD=...          # game stack only
#   HOME_BACKEND_PORT=8888         # optional host port override

# --- Local dev: Unraid GraphQL (Docker container status) ---
UNRAID_GRAPHQL_URL=http://tower:8080/graphql
UNRAID_API_KEY=

# --- Local dev: optional overrides ---
# VITE_LAUNCH_HOST=tower
# VITE_LAUNCH_PROTOCOL=http
# DOCKER_SOCKET_PATH=/var/run/docker.sock
# LAUNCHPAD_CONFIG_PATH=/path/to/test/apps.json
# REACHABILITY_GATEWAY=http://127.0.0.1

# --- Game stack (local dev / compose) ---
# Local dev (host Postgres or published compose port): use localhost.
# docker-compose.unraid.yml sets DATABASE_URL to @db:5432 inside the game-network.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/game_hub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=game_hub
VITE_BACKEND_URL=http://localhost:3001
