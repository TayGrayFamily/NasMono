{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev: Server",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm run dev:game-server",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Dev: Hub",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm run dev:game",
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Dev: Game (Server + Hub)",
      "configurations": ["Dev: Server", "Dev: Hub"],
      "stopAll": true
    }
  ]
}
