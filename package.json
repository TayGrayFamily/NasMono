{
  "name": "web-monorepo",
  "private": true,
  "version": "0.0.17",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "start:all": "pnpm --filter ./packages/home --filter ./packages/game-server start --parallel",
    "dev": "cd packages/home && pnpm run dev",
    "start": "pnpm start:all",
    "check": "pnpm format:check && pnpm lint && pnpm -r build",
    "build": "pnpm -r run build",
    "bootstrap": "pnpm -w install",
    "lint": "pnpm -r run lint",
    "format": "pnpm exec -- prettier --write .",
    "format:check": "pnpm exec -- prettier --check .",
    "preview": "pnpm --filter ./packages/home preview",
    "lint-staged": "lint-staged",
    "husky:normalize": "./scripts/normalize-husky-hooks.sh"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,scss,md,json,html}": [
      "pnpm run format"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "husky": "9.1.7",
    "lint-staged": "^14.0.0",
    "prettier": "3.7.4",
    "typescript-eslint": "^8.50.0"
  }
}
