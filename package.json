{
  "name": "web-monorepo",
  "private": true,
  "version": "0.0.64",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "ready": "pnpm format && pnpm lint && pnpm verify",
    "dev:home": "cd packages/home && pnpm run dev",
    "dev:game": "bash scripts/dev-game.sh",
    "dev:game-hub": "pnpm --filter game-hub dev",
    "dev:game-server": "pnpm --filter game-server dev",
    "start:postgres": "bash scripts/start-postgres-dev.sh",
    "check": "pnpm format:check && pnpm lint && pnpm -r build",
    "test": "pnpm -r run test",
    "verify": "pnpm check && pnpm test && node scripts/smoke-home.mjs --skip-build",
    "smoke": "node scripts/smoke-home.mjs",
    "smoke:game": "node scripts/smoke-game.mjs",
    "build": "pnpm -r run build",
    "bootstrap": "pnpm -w install",
    "lint": "pnpm -r run lint",
    "format": "pnpm exec -- prettier --write .",
    "format:check": "pnpm exec -- prettier --check .",
    "lint:fix": "pnpm -r run lint --fix",
    "preview": "pnpm --filter ./packages/home preview",
    "lint-staged": "lint-staged",
    "husky:normalize": "./scripts/normalize-husky-hooks.sh"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,scss,md,json,html}": [
      "pnpm run format"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/supertest": "7.2.0",
    "@vitest/ui": "4.1.3",
    "eslint": "^9.39.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "husky": "9.1.7",
    "lint-staged": "^14.0.0",
    "prettier": "3.7.4",
    "supertest": "7.2.2",
    "typescript-eslint": "^8.50.0",
    "vitest": "4.1.3"
  }
}
